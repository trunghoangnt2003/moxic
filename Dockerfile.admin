# Build stage
FROM node:22-alpine AS build
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /app
COPY Moxic.Admin/package*.json ./
RUN npm ci
COPY Moxic.Admin/src ./src
COPY Moxic.Admin/index.html Moxic.Admin/tsconfig.json Moxic.Admin/tsconfig.app.json Moxic.Admin/tsconfig.node.json Moxic.Admin/vite.config.ts ./
RUN npm run build

# Runtime stage
FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

