# Build stage
FROM node:22-alpine AS build
WORKDIR /app
COPY Moxic.Admin/package*.json ./
RUN npm ci
COPY Moxic.Admin/src ./src
COPY Moxic.Admin/index.html tsconfig.json tsconfig.app.json vite.config.ts ./
RUN npm run build

# Runtime stage
FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
