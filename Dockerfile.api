# Build stage
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files (strip API/ prefix so paths match)
COPY API/Moxic.Shared/Moxic.Shared.csproj Moxic.Shared/
COPY API/Moxic.Core/Moxic.Core.csproj Moxic.Core/
COPY API/Moxic.Infrastructure/Moxic.Infrastructure.csproj Moxic.Infrastructure/
COPY API/Moxic.Api/Moxic.Api.csproj Moxic.Api/
RUN dotnet restore Moxic.Api/Moxic.Api.csproj

# Copy source files
COPY API/ .
RUN dotnet publish Moxic.Api/Moxic.Api.csproj -c Release -o /app --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
COPY --from=build /app .
ENTRYPOINT ["dotnet", "Moxic.Api.dll"]
