# Build stage
FROM node:22-alpine AS build
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL
WORKDIR /app
COPY Moxic.Web/package*.json ./
RUN npm ci
COPY Moxic.Web/src ./src
COPY Moxic.Web/index.html Moxic.Web/tsconfig.json Moxic.Web/tsconfig.app.json Moxic.Web/tsconfig.node.json Moxic.Web/vite.config.ts ./
RUN npm run build

# Runtime stage
FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

